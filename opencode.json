{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/glm-5.3-flash-free",
  "instructions": [
    "constitution.md",
    "memoria.md"
  ],
  "agent": {
    "plan": {
      "model": "opencode/nemotron-3.5-super-vl-free"
    },
    "build": {
      "model": "opencode/nemotron-3.5-lightning-free"
    },
    "spec-writer": {
      "model": "opencode/nemotron-3.5-super-vl-free"
    },
    "modelador-mongo": {
      "model": "opencode/nemotron-3.5-super-vl-free"
    },
    "dev-go": {
      "model": "opencode/nemotron-3.5-lightning-free"
    },
    "qa-go": {
      "model": "opencode/glm-5.3-flash-free"
    },
    "devops-mcp": {
      "model": "opencode/nemotron-3.5-super-vl-free",
      "tools": {
        "azure_*": true,
        "cloudinary-assets_*": true,
        "cloudinary-config_*": true
      }
    },
    "revisor-constitucion": {
      "model": "opencode/big-pickle"
    },
    "gestor-repo": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "tools": {
        "github_*": true
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "go version": "allow"
    },
    "cloudinary-assets_*": "deny",
    "cloudinary-config_*": "deny",
    "azure_*": "deny",
    "github_*": "deny"
  },
  "mcp": {
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "enabled": true
    },
    "cloudinary-assets": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--package",
        "@cloudinary/asset-management-mcp",
        "--",
        "mcp",
        "start"
      ],
      "environment": {
        "CLOUDINARY_URL": "{env:CLOUDINARY_URL}"
      },
      "enabled": true
    },
    "cloudinary-config": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--package",
        "@cloudinary/environment-config-mcp",
        "--",
        "mcp",
        "start"
      ],
      "environment": {
        "CLOUDINARY_URL": "{env:CLOUDINARY_URL}"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    }
  },
  "tools": {
    "azure_*": false,
    "cloudinary-assets_*": false,
    "cloudinary-config_*": false,
    "github_*": false
  }
}
