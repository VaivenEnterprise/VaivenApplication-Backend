# deploy/.env.example — variables de la API en la VM (spec 002, T030).
# El archivo real es /opt/vaiven/<entorno>/.env (600, dueño deploy) y se genera
# EN LA VM: nunca se sube al repositorio ni se pega en conversaciones.
# APP_ENV, HTTP_ADDR, TLS_* y GOMEMLIMIT los fija deploy/docker-compose.yml.

# MongoDB del stack base: usuario de aplicación y base del entorno.
# mongodb://vaiven_app:<MONGO_APP_PASSWORD>@mongo:27017/vaiven_<entorno>?replicaSet=rs0&authSource=vaiven_<entorno>
MONGO_URI=
MONGO_DB=

# Redis del stack base: redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=

# Cloudinary (las mismas credenciales que CLOUDINARY_URL, por separado).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Autenticación (spec 003): genera el valor EN LA VM con `openssl rand -hex 32`.
JWT_ACCESS_SECRET=

# Opcionales.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# Swagger UI en /docs (opcional). Por defecto: activo en staging, apagado en
# production; en production DOCS_ENABLED=true es un error de arranque.
# DOCS_ENABLED=false

# IA generativa (spec 014). Las dos funciones nacen APAGADAS. Encender alguna
# exige AI_API_KEY (Groq: console.groq.com, cuenta del proyecto). La clave de
# producción es distinta de la de staging (CA-02). Se aplica con
# scripts/set-ai-key.sh (parámetro protegido, nunca en el repositorio).
AI_ENABLED=false
ASSISTANT_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=

# Proveedor propio para las sugerencias por foto (spec 014, T017): si se omiten,
# toman los AI_*. OpenRouter con un modelo gratuito con visión. La clave se
# aplica con PROVIDER=openrouter bash scripts/set-ai-key.sh <entorno> --enable.
SUGGEST_PROVIDER=openai
SUGGEST_BASE_URL=https://openrouter.ai/api/v1
SUGGEST_MODEL=google/gemma-4-31b-it:free
SUGGEST_API_KEY=
