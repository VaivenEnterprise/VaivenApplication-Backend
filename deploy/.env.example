# deploy/.env.example — variables de la API en la VM (spec 002, T030).
# El archivo real es /opt/vaiven/<entorno>/.env (600, dueño deploy) y se genera
# EN LA VM: nunca se sube al repositorio ni se pega en conversaciones.
# APP_ENV, HTTP_ADDR, TLS_* y GOMEMLIMIT los fija deploy/docker-compose.yml.

# MongoDB del stack base: usuario de aplicación y base del entorno.
# mongodb://vaiven_app:<MONGO_APP_PASSWORD>@mongo:27017/vaiven_<entorno>?replicaSet=rs0&authSource=vaiven_<entorno>
MONGO_URI=
MONGO_DB=

# Redis del stack base: redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=

# Cloudinary (las mismas credenciales que CLOUDINARY_URL, por separado).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Autenticación (spec 003): genera el valor EN LA VM con `openssl rand -hex 32`.
JWT_ACCESS_SECRET=

# Opcionales.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# Swagger UI en /docs (opcional). Por defecto: activo en staging, apagado en
# production; en production DOCS_ENABLED=true es un error de arranque.
# DOCS_ENABLED=false
