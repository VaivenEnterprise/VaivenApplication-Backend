# deploy/.env.production.example — variables de la API de PRODUCCIÓN en la VM
# (spec 013, T001; Art. XIII.6). Solo nombres: ningún valor real va aquí.
# El archivo real es /opt/vaiven/production/.env (600, dueño deploy) y se genera
# EN LA VM; nunca se sube al repositorio ni se pega en conversaciones.
# APP_ENV, HTTP_ADDR, TLS_* y GOMEMLIMIT los fija deploy/docker-compose.yml.
# TODOS los secretos son NUEVOS y distintos de los de staging (CA-02).

# Red del stack de datos de producción (deploy/production/docker-compose.yml).
# Compose la toma de este .env al interpolar; sin ella la API se uniría a la
# red de staging (base_vaiven-net).
VAIVEN_NETWORK=vaiven-production-net

# MongoDB PROPIO de producción: usuario de la aplicación con permisos solo
# sobre vaiven_prod; su contraseña es MONGO_APP_PASSWORD de
# /opt/vaiven/production/data.env (la crea deploy/production/init-env.sh).
# mongodb://vaiven_app:<MONGO_APP_PASSWORD>@mongo:27017/vaiven_prod?replicaSet=rs0&authSource=vaiven_prod
MONGO_URI=
MONGO_DB=vaiven_prod

# Redis PROPIO de producción: redis://:<REDIS_PASSWORD>@redis:6379/0
# (REDIS_PASSWORD de /opt/vaiven/production/data.env).
REDIS_URL=

# Cloudinary: misma cuenta que staging, carpeta propia (RF-03). Requisito
# previo: la llave filtrada ya rotada (P-1).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=vaiven/production

# Autenticación: generar EN LA VM con `openssl rand -hex 32`; distinto de staging.
JWT_ACCESS_SECRET=

# Orígenes permitidos (si aplica) y nivel de registro.
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# En production DOCS_ENABLED=true es un error de arranque: se deja apagado.
DOCS_ENABLED=false
