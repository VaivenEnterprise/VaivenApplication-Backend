# Balanceador del prototipo local (spec 018, propuesta). HTTP en claro solo
# dentro de 127.0.0.1: en un entorno real Caddy terminaría TLS o pasaría TCP.
{
	admin off
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 20s
			idle 60s
		}
		max_header_size 16KB
	}
}

:80 {
	# Sin «encode»: la compresión la hace la API (no se comprime dos veces).
	reverse_proxy api1:8080 api2:8080 {
		lb_policy round_robin
		# Si una réplica no acepta la conexión, se reintenta en la otra.
		lb_try_duration 3s
		lb_try_interval 250ms

		# Salud activa: /healthz cada 2 s; una réplica que falla sale del grupo.
		health_uri /healthz
		health_interval 2s
		health_timeout 1s
		health_status 200

		# Salud pasiva: un fallo la saca 10 s.
		fail_duration 10s
		max_fails 1
		unhealthy_status 502 503 504

		# Límites hacia cada réplica.
		unhealthy_request_count 200
		transport http {
			dial_timeout 2s
			response_header_timeout 15s
			keepalive 30s
			keepalive_idle_conns_per_host 32
		}

		# Caddy no confía en el X-Forwarded-For del cliente (no hay
		# trusted_proxies): lo reemplaza por la IP real de la conexión.
	}
}
