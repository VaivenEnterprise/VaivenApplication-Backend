[
  {
    "$match": {
      "$text": {
        "$search": "taladro eléctrico"
      },
      "status": "active",
      "ownerId": {
        "$ne": "u1"
      }
    }
  },
  {
    "$addFields": {
      "score": {
        "$meta": "textScore"
      }
    }
  },
  {
    "$sort": {
      "score": {
        "$numberInt": "-1"
      },
      "_id": {
        "$numberInt": "-1"
      }
    }
  },
  {
    "$addFields": {
      "_ownerOid": {
        "$convert": {
          "input": "$ownerId",
          "to": "objectId",
          "onError": null,
          "onNull": null
        }
      }
    }
  },
  {
    "$lookup": {
      "from": "users",
      "localField": "_ownerOid",
      "foreignField": "_id",
      "pipeline": [
        {
          "$project": {
            "displayName": {
              "$numberInt": "1"
            },
            "status": {
              "$numberInt": "1"
            },
            "suspendedUntil": {
              "$numberInt": "1"
            },
            "ratingSum": {
              "$numberInt": "1"
            },
            "ratingCount": {
              "$numberInt": "1"
            }
          }
        }
      ],
      "as": "_owner"
    }
  },
  {
    "$unwind": "$_owner"
  },
  {
    "$match": {
      "_owner.status": "active",
      "_owner.suspendedUntil": {
        "$not": {
          "$gt": {
            "$date": {
              "$numberLong": "1794160800000"
            }
          }
        }
      }
    }
  },
  {
    "$limit": {
      "$numberLong": "21"
    }
  },
  {
    "$project": {
      "title": {
        "$numberInt": "1"
      },
      "category": {
        "$numberInt": "1"
      },
      "modality": {
        "$numberInt": "1"
      },
      "pricePerDayCents": {
        "$numberInt": "1"
      },
      "zone": {
        "$numberInt": "1"
      },
      "location": {
        "$numberInt": "1"
      },
      "createdAt": {
        "$numberInt": "1"
      },
      "firstPhoto": {
        "$first": "$photos"
      },
      "photoCount": {
        "$size": {
          "$ifNull": [
            "$photos",
            []
          ]
        }
      },
      "owner": {
        "id": "$ownerId",
        "displayName": "$_owner.displayName",
        "ratingSum": "$_owner.ratingSum",
        "ratingCount": "$_owner.ratingCount"
      },
      "sortKey": "$score"
    }
  }
]
