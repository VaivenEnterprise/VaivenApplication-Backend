# Configuracion local y secretos (en cualquier carpeta)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# Llaves SSH privadas sin extensión (las públicas .pub sí pueden versionarse)
id_rsa
id_ecdsa
id_ed25519
vaiven_azure
# Notas locales de Obsidian
.obsidian/
.aws/
secrets.local/
credentials.json
service-account*.json

# Node, TypeScript y Expo
node_modules/
.expo/
.expo-shared/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Go: binarios y resultados locales
/bin/
/tmp/
*.test
coverage.out
coverage.html

# Terraform: conservar .terraform.lock.hcl
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Logs, editores y sistema operativo
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Reportes locales de pruebas de mutación y carga (spec 017, T010)
/reports/

# Archivos comprimidos, respaldos y volcados (SEC-005): pueden arrastrar un .env
# real sin que se vea en el diff. Si alguno debe versionarse, se agrega con
# una excepción explícita y pasa por scripts/scan-archives.py en CI.
*.tgz
*.tar
*.tar.*
*.tbz2
*.txz
*.gz
*.bz2
*.xz
*.zst
*.zip
*.7z
*.rar
*.sql
*.dump
*.bak

# Carpetas temporales y salidas de asistentes (SEC-003)
_tmp/
Claude outputs/
NUL
__pycache__/
