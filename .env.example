# Plantilla de variables del backend VAIVÉN (spec 001). SIN valores reales.
# Copia a .env (ignorado por git) solo donde corresponda; los valores reales
# nunca van al repositorio, a memoria.md, a specs ni a conversaciones con modelos.
# Detalle de cada variable: docs/servicios.md §3.

# --- Entorno local de quien administra (variable del sistema, no archivo) ---
# Panel de Cloudinary -> API Keys. Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# --- .env local de despliegue (no es secreto) ---
# Nombre DNS de la IP pública de la VM.
AZURE_HOST=vaiven-staging.westus2.cloudapp.azure.com

# --- /opt/vaiven/base/.env en la VM (600, dueño deploy) ---
# Se generan EN LA VM con `openssl rand -hex 24`; nunca se escriben aquí.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# --- API en desarrollo local (spec 002, plan §4.1). Copia a .env ---
# Valores de ejemplo para la máquina de cada persona; ninguno es secreto.
# MongoDB local: `make up` (docker-compose.yml de la raíz, sin autenticación).
APP_ENV=development
APP_VERSION=dev
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=15s
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=vaiven_dev
MONGO_CONNECT_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=debug

# --- Servicios de la API (spec 002, fase 5; plan §9) ---
# Cloudinary: obligatorias salvo APP_ENV=test. En local puedes usar las tuyas;
# la API no llama a Cloudinary al arrancar (solo `go run ./cmd/admin check-services`).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Por defecto vaiven/<APP_ENV>.
CLOUDINARY_BASE_FOLDER=
# Redis: obligatoria en staging y production (formato redis://:<contraseña>@redis:6379/0).
# En local es opcional: sin ella se usa el limitador y la caché en memoria.
REDIS_URL=
# HTTPS: obligatorias en staging y production (Art. XIV.4); en la VM apuntan a
# /etc/letsencrypt/live/<host>/fullchain.pem y privkey.pem. En local, vacías = HTTP.
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Autenticación (spec 003, plan §5) ---
# Obligatoria salvo APP_ENV=test; al menos 32 caracteres. Genérala con
# `openssl rand -hex 32` (en staging, dentro de la VM); nunca la escribas aquí.
JWT_ACCESS_SECRET=
# Vida del token de acceso y del refresh token.
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h
# Peticiones por minuto por IP en register, login y refresh (RF-07).
RATE_LIMIT_AUTH_PER_MIN=10

# --- Imágenes (spec 004, plan §5; POL-13) ---
# Tamaño máximo por imagen en bytes (5 MB) y firmas de subida por persona y hora.
IMAGE_MAX_BYTES=5242880
IMAGE_SIGNATURE_PER_HOUR=30
